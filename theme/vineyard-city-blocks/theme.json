{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "1140px", "wideSize": "1320px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "primary", "name": "Vineyard Blue", "color": "#0d4a76" },
        { "slug": "secondary", "name": "Vineyard Gold", "color": "#fdb415" },
        { "slug": "contrast", "name": "Text", "color": "#2f2f2f" },
        { "slug": "heading", "name": "Headings", "color": "#111111" },
        { "slug": "slate", "name": "Slate", "color": "#4d616f" },
        { "slug": "muted", "name": "Soft Blue", "color": "#6f88a5" },
        { "slug": "light", "name": "Light Gray", "color": "#f6f7f8" },
        { "slug": "base", "name": "White", "color": "#ffffff" }
      ]
    },
    "typography": {
      "fluid": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "body", "name": "Montserrat", "fontFamily": "Montserrat, sans-serif",
          "fontFace": [
            { "fontFamily": "Montserrat", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/montserrat.woff2"] },
            { "fontFamily": "Montserrat", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/montserrat-italic.woff2"] }
          ]
        },
        { "slug": "system", "name": "System", "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif" },
        { "slug": "serif", "name": "Serif", "fontFamily": "Georgia, 'Times New Roman', serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "14px" },
        { "slug": "medium", "name": "Normal", "size": "16px" },
        { "slug": "large", "name": "Large", "size": "21px" },
        { "slug": "x-large", "name": "Extra Large", "size": "32px" },
        { "slug": "xx-large", "name": "Huge", "size": "60px" }
      ]
    },
    "spacing": { "units": ["px", "%", "em", "rem", "vh", "vw"] },
    "custom": { "headerHeight": "78px" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.4" },
    "spacing": { "blockGap": "20px", "padding": { "left": "20px", "right": "20px" } },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--heading)" }, "typography": { "fontWeight": "400", "lineHeight": "1.2" } },
      "h1": { "typography": { "fontSize": "36px" } },
      "h2": { "typography": { "fontSize": "32px" } },
      "h3": { "typography": { "fontSize": "28px" } },
      "h4": { "typography": { "fontSize": "21px" } },
      "h5": { "typography": { "fontSize": "16px" } },
      "h6": { "typography": { "fontSize": "14px" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" }, "typography": { "textDecoration": "underline" }, ":hover": { "color": { "text": "var(--wp--preset--color--secondary)" } } },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--base)" },
        "border": { "radius": "4px" },
        "typography": { "fontWeight": "700", "fontSize": "16px" },
        "spacing": { "padding": { "top": "12px", "bottom": "13px", "left": "40px", "right": "40px" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--secondary)", "text": "var(--wp--preset--color--primary)" } }
      }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontSize": "15px", "fontWeight": "700" }, "color": { "text": "var(--wp--preset--color--primary)" } },
      "core/post-title": { "color": { "text": "var(--wp--preset--color--heading)" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-full-width", "title": "Full width (no left column)", "postTypes": ["page"] }
  ]
}
