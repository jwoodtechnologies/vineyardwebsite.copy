						  RZ.recordid = '111';
						  RZ.name = 'RZdelete' + RZ.recordid;
						  RZ.img = '<span class="rzFaqBtn"><i class="fa fa-trash"></i><span class="sr-only">Delete</span></span>';
						  RZ.options = '';
						  if (typeof RZaction != 'undefined') RZaction('delete');
                      </script>

                      <span class="seq-no"><script language="JavaScript" type="text/JavaScript">
if (typeof RZlogin != 'undefined') RZlogin('7.00', 'revizefaq', 'u');</script>
</span>
                    </div>
                  </div>

                  <div id="collapse8150b6" class="faq-answer collapse">
                    <p><span style="font-weight: 400;">Yes. The RDA is designed to sunset after key goals are met. When that happens:</span></p>
<ul>
<li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">100% of all property taxes revert to the school district and other taxing entities</span></li>
<li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">The area continues to thrive from the permanent infrastructure already in place</span></li>
<li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">Vineyard and its partners will see compounded returns for decades</span></li>
</ul>
                  </div>
                </div>
                
    			
                
                <!-- pageid: 44  -->
                
                <div class="faq-item">
                  <div class="faq-question">
                    <a class="faq-question-header" href="https://www.vineyardutah.gov/government/redevelopment_agency/faqs.php#collapse8150b7" data-toggle="collapse" data-target="#collapse8150b7">When did Geneva Steel close?</a>
                    <div class="faq-editbtns">
                      <a name="revizefaq_rz112"></a>
                      <script language="JavaScript" type="text/JavaScript">
						  RZ.module = 'revizefaq'; RZ.linkname = '';
						  RZ.template = '*none*'; RZ.recordid = '112';
						  RZ.nexturl = "editforms/revizefaq-editform.jsp";
						  RZ.popupwidth = ''; RZ.popupheight = ''; RZ.popupscroll = '';
						  RZ.img = '<span class="rzFaqBtn"><i class="fa fa-pencil"></i><span class="sr-only">Edit</span></span>';
						  RZ.set = '';
						  RZ.options = '';
						  if (typeof RZaction != 'undefined') RZaction('edititem');
                      </script>
                      <script language="JavaScript" type="text/JavaScript">
						  RZ.module = 'revizefaq';
						  RZ.recordid = '112';
						  RZ.name = 'RZdelete' + RZ.recordid;
						  RZ.img = '<span class="rzFaqBtn"><i class="fa fa-trash"></i><span class="sr-only">Delete</span></span>';
						  RZ.options = '';
						  if (typeof RZaction != 'undefined') RZaction('delete');
                      </script>

                      <span class="seq-no"><script language="JavaScript" type="text/JavaScript">
if (typeof RZlogin != 'undefined') RZlogin('8.00', 'revizefaq', 'u');</script>
</span>
                    </div>
                  </div>

                  <div id="collapse8150b7" class="faq-answer collapse">
                    <span data-teams="true">The steel plant closed in 2001 after declaring bankruptcy. The Geneva Steel facility was constructed by the Defense Plant Corporation, an arm of the federal government in 1912. It was purchased in 1946 by USX Corporation (USX), United States Steel Division (USS). Geneva Steel acquired the facility in 1987 and operated the facility until 2001 until declaring bankruptcy. In 2005 Anderson Geneva LLC, and affiliates purchased the land from the Geneva Steel bankruptcy estate and now manage the Site deconstruction, remediation, and redevelopment.&nbsp; The Bankruptcy trustee sold the steel making equipment to Qingdao Iron and Steel Group Co., Ltd. of China. Qingdao disassembled and removed all of its purchased equipment and completed its work in early 2006. CST Environmental, Inc. purchased the salvage rights from the bankruptcy estate in December 2004 with the requirement to demolish all of the buildings and structures to grade level.</span>
                  </div>
                </div>
                
    			
                
                <!-- pageid: 44  -->
                
                <div class="faq-item">
                  <div class="faq-question">
                    <a class="faq-question-header" href="https://www.vineyardutah.gov/government/redevelopment_agency/faqs.php#collapse8150b8" data-toggle="collapse" data-target="#collapse8150b8">Who is in charge of cleanup of the former steel mill site?</a>
                    <div class="faq-editbtns">
                      <a name="revizefaq_rz113"></a>
                      <script language="JavaScript" type="text/JavaScript">
						  RZ.module = 'revizefaq'; RZ.linkname = '';
						  RZ.template = '*none*'; RZ.recordid = '113';
						  RZ.nexturl = "editforms/revizefaq-editform.jsp";
						  RZ.popupwidth = ''; RZ.popupheight = ''; RZ.popupscroll = '';
						  RZ.img = '<span class="rzFaqBtn"><i class="fa fa-pencil"></i><span class="sr-only">Edit</span></span>';
