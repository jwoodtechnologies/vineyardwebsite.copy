          <!-- placement: 8152 doc_rec: category-46 -->
           
          <div class="faq-category">
            <a class="faq-header " href="https://www.vineyardutah.gov/government/redevelopment_agency/faqs.php#faq-questions-46" data-toggle="collapse" data-target="#faq-questions-46">Finance</a>
			<div class="faq-editbtns">
				<a name="revizefaqouter_rz46"></a>
				<script language="JavaScript" type="text/JavaScript">
